# .env template for the machine that runs the packaged Orange Cafe .exe —
# the single "server" PC in the cafe. Every other device (waiter tablet,
# kitchen screen, cashier, customer phone) just opens a browser at this
# machine's LAN address and installs nothing.
#
# Copy to .env before running `php artisan native:build win`, fill in the
# blanks, then restore your development .env afterwards. See
# docs/desktop-build.md.

APP_NAME="Orange Cafe"
APP_ENV=production
APP_KEY=base64:2Toivrox3fGtghqwXTyYpMy9sGzjEK/NAqywrmQcgvM=
APP_DEBUG=false
APP_TIMEZONE=Asia/Hebron
# Only used for URLs generated outside a request (console, queued jobs).
# Table QR codes do NOT come from here — see PUBLIC_BASE_URL below.
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Desktop packaging
# --------------------------------------------------------------------------
NATIVEPHP_APP_ID=ps.befoundonline.orangecafe
NATIVEPHP_APP_VERSION=1.1.9
NATIVEPHP_APP_AUTHOR=befoundonline.ps
NATIVEPHP_APP_COPYRIGHT="Copyright 2026 befoundonline.ps"
NATIVEPHP_APP_DESCRIPTION="Orange Cafe — restaurant server"
NATIVEPHP_APP_WEBSITE=https://befoundonline.ps
NATIVEPHP_DEEPLINK_SCHEME=orangecafe
NATIVEPHP_UPDATER_ENABLED=false
FIRST_RUN_LOAD_LEGACY_DATA=true

# The second Laravel server, bound to the LAN — this is the one every other
# device in the building talks to. NativePHP's own internal server is
# loopback-only and serves nothing but the control window.
LAN_SERVER_ENABLED=true
LAN_SERVER_HOST=0.0.0.0
LAN_SERVER_PORT=8000

NATIVE_START_AT_LOGIN=true

# The address printed onto table QR codes. Leave blank to use this machine's
# detected LAN address on LAN_SERVER_PORT; set it explicitly when the machine
# has a static IP or the menu is reachable through a real domain. Editable
# afterwards from the app's control window, and any change means reprinting
# the table signs.
PUBLIC_BASE_URL=

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# SQLite, and not by preference: NativePHP's bundled PHP is a static build
# shipping pdo_sqlite only — no pdo_mysql, and no ext/ directory to add one
# to. The packaged app also overrides this with its own per-user SQLite file
# under the Windows application-data directory (NativeServiceProvider::
# rewriteDatabase), which is where the cafe's real data lives, so it survives
# reinstalling the app.
DB_CONNECTION=sqlite

# Source for the one-off `php artisan app:import-from-mysql`, when moving an
# existing MySQL installation's data across. Irrelevant afterwards.
IMPORT_DB_HOST=127.0.0.1
IMPORT_DB_PORT=3306
IMPORT_DB_DATABASE=orange
IMPORT_DB_USERNAME=root
IMPORT_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# --------------------------------------------------------------------------
# Reverb (live updates: new order to the kitchen, waiter calls, table status)
# --------------------------------------------------------------------------
# REVERB_APP_KEY is compiled into the JS bundle, so anyone who can load a page
# can read it — it is an identifier, not a secret, and the same value for every
# install is fine.
#
# REVERB_APP_SECRET and APP_KEY are different: the value set here is only a
# build-time placeholder. On its first launch each install replaces both with
# values of its own and remembers them (NativeAppServiceProvider::
# ensureInstallSpecificSecrets), so one leaked installer does not hand out
# every customer's session key and order-feed credentials.
#
# REVERB_HOST must stay 127.0.0.1 and is not editable from the control panel.
# It is the address THIS app publishes events to (config/broadcasting.php),
# and Reverb runs on this same machine — while the address every browser
# dials is its own page's host (resources/js/echo.js), and the server binds
# 0.0.0.0 (App\Services\Native\NativeServices) so all of them can reach it.
# Setting it to the machine's LAN address looks equivalent and is a time bomb:
# the router hands out a new lease, and live updates stop everywhere while
# every page still loads perfectly.
#
# VITE_REVERB_HOST is left empty for the same reason — an IP baked into the
# JS bundle is ignored at runtime, so leaving it set would only mislead.
REVERB_APP_ID=145238
REVERB_APP_KEY=b1d99f7fdf1b4ad5db92
REVERB_APP_SECRET=FafIhY2fqBLuniKMPxw2qbQfr3XqjJfx4gzSorKQ
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --------------------------------------------------------------------------
# Printing
# --------------------------------------------------------------------------
# pdftoppm is resolved at runtime by App\Services\Printing\PopplerBinary,
# which finds the copy bundled at bin/poppler. Set this only to force a
# different binary.
# POPPLER_PDFTOPPM_PATH=

# Direct-USB printing needs PHP's FFI extension, which the NativePHP runtime
# does not ship — on the packaged app, printers must be networked (IP+port).
# LIBUSB_PATH=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

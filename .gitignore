/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.production
# Created by the documented desktop build procedure, which swaps the
# production .env in and this one back out afterwards.
.env.dev-backup

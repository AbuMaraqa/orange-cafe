/dist

# Downloaded build inputs and outputs — reproduced by build/fetch-poppler.ps1
# and `php artisan native:build`, never edited by hand.
/build/cache
/bin/poppler

# Local development database. Each install (and the packaged app) gets its
# own; see docs/desktop-build.md.
/database/*.sqlite
/database/*.sqlite-shm
/database/*.sqlite-wal
